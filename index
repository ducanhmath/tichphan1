<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Bài học phép tính tích phân theo hướng dạng toán và cách giải: bảng nguyên hàm, biến đổi, đổi biến, tích phân từng phần và bài tập tự chấm.">
    <meta name="author" content="Giảng viên Nguyễn Đức Ánh">
    <title>Phép tính tích phân | Dạng toán và cách giải</title>

    <script>
        window.MathJax = {
            tex: {
                inlineMath: [["$", "$"], ["\\(", "\\)"]],
                displayMath: [["$$", "$$"], ["\\[", "\\]"]],
                processEscapes: true
            },
            svg: { fontCache: "global" },
            options: {
                skipHtmlTags: ["script", "noscript", "style", "textarea", "pre", "code"]
            }
        };
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>

    <style>
        :root {
            --page-bg: #f3f8f7;
            --page-bg-2: #eef4fa;
            --surface: rgba(255,255,255,.95);
            --surface-solid: #fff;
            --surface-soft: #f8fbfb;
            --primary: #16766d;
            --primary-dark: #0e5b54;
            --primary-soft: #ddf3ef;
            --secondary: #416fb0;
            --secondary-soft: #e8f0fc;
            --accent: #d97b3e;
            --accent-soft: #fff0e5;
            --purple: #7556a5;
            --purple-soft: #f1ebfc;
            --success: #22825b;
            --success-soft: #e5f7ef;
            --danger: #c44d5a;
            --danger-soft: #fdecef;
            --warning: #a96d13;
            --warning-soft: #fff5da;
            --text: #24343a;
            --text-soft: #52666d;
            --text-muted: #72868c;
            --border: #d7e5e3;
            --border-strong: #bcd3d0;
            --shadow-sm: 0 7px 20px rgba(39,78,82,.07);
            --shadow-md: 0 15px 38px rgba(39,78,82,.12);
            --shadow-lg: 0 24px 62px rgba(39,78,82,.16);
            --radius-sm: 10px;
            --radius-md: 18px;
            --radius-lg: 28px;
            --content-width: 1180px;
            --topbar-height: 68px;
            --toc-height: 58px;
            --font-size-base: 16px;
        }

        body.large-text { --font-size-base: 18px; }
        body.high-contrast {
            --page-bg: #fff;
            --page-bg-2: #f3f3f3;
            --surface: #fff;
            --surface-solid: #fff;
            --surface-soft: #fafafa;
            --primary: #005f56;
            --primary-dark: #003f39;
            --primary-soft: #d4f3ed;
            --secondary: #164c9c;
            --secondary-soft: #e2edff;
            --text: #111719;
            --text-soft: #29373b;
            --text-muted: #485a60;
            --border: #aab8b6;
            --border-strong: #728a86;
        }

        * { box-sizing: border-box; }
        html {
            scroll-behavior: smooth;
            scroll-padding-top: calc(var(--topbar-height) + var(--toc-height) + 22px);
        }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
            font-size: var(--font-size-base);
            line-height: 1.7;
            color: var(--text);
            background:
                radial-gradient(circle at 8% 0%, rgba(69,165,150,.14), transparent 28%),
                radial-gradient(circle at 95% 7%, rgba(83,126,190,.12), transparent 29%),
                linear-gradient(145deg, var(--page-bg), var(--page-bg-2));
        }
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            z-index: -1;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(22,118,109,.024) 1px, transparent 1px),
                linear-gradient(90deg, rgba(22,118,109,.024) 1px, transparent 1px);
            background-size: 32px 32px;
        }
        button, input { font: inherit; }
        button, a { -webkit-tap-highlight-color: transparent; }
        button { border: 0; }
        a { color: inherit; }
        ::selection { color: #fff; background: var(--primary); }
        :focus-visible { outline: 3px solid rgba(65,111,176,.4); outline-offset: 3px; }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            min-height: var(--topbar-height);
            background: rgba(247,252,251,.9);
            border-bottom: 1px solid rgba(188,211,208,.72);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }
        .topbar-inner {
            width: min(calc(100% - 28px), var(--content-width));
            min-height: var(--topbar-height);
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }
        .brand {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }
        .brand-logo {
            width: 46px;
            height: 46px;
            flex: 0 0 auto;
            display: grid;
            place-items: center;
            color: #fff;
            font-size: 1.3rem;
            font-weight: 900;
            border-radius: 15px;
            background: linear-gradient(145deg, var(--primary), var(--secondary));
            box-shadow: 0 9px 22px rgba(22,118,109,.22);
        }
        .brand-text { min-width: 0; }
        .brand-title,
        .brand-subtitle {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .brand-title { font-size: .98rem; font-weight: 850; line-height: 1.25; }
        .brand-subtitle { margin-top: 2px; color: var(--text-muted); font-size: .77rem; }
        .topbar-actions { display: flex; align-items: center; gap: 8px; }
        .icon-button {
            width: 42px;
            height: 42px;
            display: inline-grid;
            place-items: center;
            color: var(--text-soft);
            cursor: pointer;
            border: 1px solid var(--border);
            border-radius: 13px;
            background: rgba(255,255,255,.78);
            transition: .2s ease;
        }
        .icon-button:hover {
            color: var(--primary);
            border-color: var(--border-strong);
            background: var(--surface-solid);
            transform: translateY(-2px);
        }
        .icon-button svg { width: 20px; height: 20px; }

        .horizontal-toc {
            position: sticky;
            top: var(--topbar-height);
            z-index: 990;
            min-height: var(--toc-height);
            border-bottom: 1px solid rgba(188,211,208,.74);
            background: rgba(255,255,255,.88);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
        .toc-scroll {
            width: min(calc(100% - 28px), var(--content-width));
            min-height: var(--toc-height);
            margin: 0 auto;
            display: flex;
            align-items: center;
            gap: 8px;
            overflow-x: auto;
            scrollbar-width: thin;
            scroll-snap-type: x proximity;
            padding: 8px 0;
        }
        .toc-scroll::-webkit-scrollbar { height: 5px; }
        .toc-scroll::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 999px; }
        .toc-link {
            flex: 0 0 auto;
            scroll-snap-align: start;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 39px;
            padding: 8px 12px;
            color: var(--text-soft);
            font-size: .83rem;
            font-weight: 750;
            text-decoration: none;
            border: 1px solid transparent;
            border-radius: 999px;
            transition: .2s ease;
        }
        .toc-link:hover,
        .toc-link.active {
            color: var(--primary-dark);
            border-color: var(--border-strong);
            background: var(--primary-soft);
        }
        .toc-number {
            width: 24px;
            height: 24px;
            display: inline-grid;
            place-items: center;
            color: var(--primary-dark);
            font-size: .7rem;
            font-weight: 900;
            border-radius: 8px;
            background: #fff;
        }
        .reading-progress {
            height: 4px;
            background: #dfe9e8;
        }
        .reading-progress-fill {
            width: 0;
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--secondary));
            transition: width .25s ease;
        }

        .page-shell {
            width: min(calc(100% - 28px), var(--content-width));
            margin: 26px auto 48px;
        }
        .main-content { min-width: 0; }

        .hero {
            position: relative;
            overflow: hidden;
            min-height: 430px;
            padding: clamp(28px, 5vw, 58px);
            display: grid;
            grid-template-columns: minmax(0,1.16fr) minmax(270px,.84fr);
            align-items: center;
            gap: 32px;
            color: #fff;
            border-radius: var(--radius-lg);
            background: linear-gradient(135deg, #135c55 0%, #247e74 48%, #426eaa 100%);
            box-shadow: var(--shadow-lg);
        }
        .hero::before,
        .hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }
        .hero::before { width: 350px; height: 350px; top: -190px; right: -70px; }
        .hero::after { width: 280px; height: 280px; left: 40%; bottom: -205px; }
        .hero-content,
        .hero-visual { position: relative; z-index: 1; }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 18px;
            padding: 7px 12px;
            color: #effffb;
            font-size: .8rem;
            font-weight: 850;
            letter-spacing: .06em;
            text-transform: uppercase;
            border: 1px solid rgba(255,255,255,.22);
            border-radius: 999px;
            background: rgba(255,255,255,.1);
        }
        .hero h1 {
            margin: 0;
            max-width: 760px;
            color: #fff;
            font-size: clamp(2.1rem, 5vw, 4.25rem);
            line-height: 1.04;
            letter-spacing: -.045em;
        }
        .hero-description {
            max-width: 700px;
            margin: 22px 0 0;
            color: rgba(255,255,255,.86);
            font-size: clamp(1rem,1.7vw,1.15rem);
        }
        .hero-meta,
        .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; }
        .hero-meta { margin-top: 22px; }
        .hero-actions { margin-top: 28px; }
        .hero-chip {
            padding: 8px 12px;
            color: rgba(255,255,255,.9);
            font-size: .82rem;
            font-weight: 750;
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 999px;
            background: rgba(255,255,255,.08);
        }
        .button {
            min-height: 46px;
            padding: 11px 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            font-weight: 850;
            text-decoration: none;
            cursor: pointer;
            border: 1px solid transparent;
            border-radius: 14px;
            transition: .2s ease;
        }
        .button:hover { transform: translateY(-2px); }
        .button-primary { color: var(--primary-dark); background: #fff; box-shadow: 0 10px 25px rgba(15,42,46,.18); }
        .button-ghost { color: #fff; border-color: rgba(255,255,255,.3); background: rgba(255,255,255,.08); }
        .hero-visual { min-height: 300px; display: grid; place-items: center; }
        .method-map {
            width: min(100%, 360px);
            display: grid;
            gap: 12px;
            transform: rotate(-2deg);
        }
        .method-card {
            padding: 14px 16px;
            display: grid;
            grid-template-columns: 46px minmax(0,1fr);
            align-items: center;
            gap: 12px;
            border: 1px solid rgba(255,255,255,.23);
            border-radius: 18px;
            background: rgba(255,255,255,.11);
            box-shadow: 0 14px 30px rgba(8,35,41,.15);
            backdrop-filter: blur(10px);
        }
        .method-card:nth-child(2) { transform: translateX(22px); }
        .method-card:nth-child(3) { transform: translateX(-6px); }
        .method-card:nth-child(4) { transform: translateX(18px); }
        .method-icon {
            width: 46px;
            height: 46px;
            display: grid;
            place-items: center;
            font-size: 1.2rem;
            font-weight: 900;
            border-radius: 14px;
            background: rgba(255,255,255,.16);
        }
        .method-card strong { display: block; color: #fff; }
        .method-card span { color: rgba(255,255,255,.77); font-size: .82rem; }

        .section {
            margin-top: 28px;
            padding: clamp(24px,4vw,40px);
            scroll-margin-top: calc(var(--topbar-height) + var(--toc-height) + 20px);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--surface);
            box-shadow: var(--shadow-sm);
        }
        .section-header {
            margin-bottom: 24px;
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }
        .section-index {
            width: 48px;
            height: 48px;
            flex: 0 0 auto;
            display: grid;
            place-items: center;
            color: #fff;
            font-weight: 900;
            border-radius: 15px;
            background: linear-gradient(145deg, var(--primary), var(--secondary));
            box-shadow: 0 9px 22px rgba(22,118,109,.2);
        }
        .section-kicker {
            margin-bottom: 4px;
            color: var(--primary);
            font-size: .76rem;
            font-weight: 850;
            letter-spacing: .09em;
            text-transform: uppercase;
        }
        .section h2 {
            margin: 0;
            font-size: clamp(1.45rem,3vw,2.05rem);
            line-height: 1.22;
            letter-spacing: -.025em;
        }
        .section-lead { margin: 8px 0 0; color: var(--text-soft); }
        .subheading { margin: 30px 0 14px; font-size: 1.16rem; line-height: 1.35; }

        .learning-grid,
        .method-grid,
        .example-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 16px;
        }
        .method-grid.three { grid-template-columns: repeat(3,minmax(0,1fr)); }
        .learning-card,
        .method-choice-card {
            position: relative;
            overflow: hidden;
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: linear-gradient(145deg,#fff,var(--surface-soft));
            transition: .2s ease;
        }
        .learning-card:hover,
        .method-choice-card:hover {
            border-color: var(--border-strong);
            box-shadow: var(--shadow-md);
            transform: translateY(-3px);
        }
        .learning-card::after,
        .method-choice-card::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg,var(--primary),var(--secondary));
        }
        .learning-card h3,
        .method-choice-card h3 { margin: 0 0 10px; color: var(--primary-dark); font-size: 1.02rem; }
        .learning-card p,
        .method-choice-card p { margin: 8px 0; color: var(--text-soft); }
        .method-choice-card .signal {
            display: inline-flex;
            margin-top: 8px;
            padding: 5px 9px;
            color: var(--secondary);
            font-size: .74rem;
            font-weight: 850;
            border-radius: 999px;
            background: var(--secondary-soft);
        }

        .formula-box {
            margin: 14px 0;
            padding: 15px;
            overflow-x: auto;
            text-align: center;
            border: 1px solid var(--border);
            border-radius: 13px;
            background: var(--primary-soft);
        }
        .formula-box.blue { background: var(--secondary-soft); }
        .formula-box.orange { background: var(--accent-soft); }
        .formula-box.purple { background: var(--purple-soft); }
        .memory-box,
        .warning-box {
            margin: 22px 0;
            padding: 18px 20px;
            display: grid;
            grid-template-columns: auto minmax(0,1fr);
            gap: 14px;
            border: 1px solid #cce4df;
            border-radius: var(--radius-md);
            background: linear-gradient(145deg,#edf9f6,#f9fdfc);
        }
        .warning-box { border-color: #f0d9a8; background: linear-gradient(145deg,var(--warning-soft),#fffdf7); }
        .memory-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            font-size: 1.2rem;
            border-radius: 13px;
            background: #d5f2eb;
        }
        .warning-box .memory-icon { background: #ffeab8; }
        .memory-box h3,
        .warning-box h3 { margin: 0 0 5px; color: var(--primary-dark); font-size: 1rem; }
        .memory-box p,
        .warning-box p { margin: 0; color: var(--text-soft); }

        .steps { display: grid; gap: 12px; margin: 16px 0; padding: 0; list-style: none; }
        .step {
            padding: 15px;
            display: grid;
            grid-template-columns: 34px minmax(0,1fr);
            align-items: start;
            gap: 12px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: #fff;
        }
        .step-number {
            width: 34px;
            height: 34px;
            display: grid;
            place-items: center;
            color: #fff;
            font-size: .85rem;
            font-weight: 900;
            border-radius: 10px;
            background: var(--primary);
        }
        .step-content strong { display: block; margin-bottom: 3px; }
        .step-content p { margin: 0; color: var(--text-soft); }

        .compact-table-wrapper { margin-top: 18px; overflow-x: auto; border: 1px solid var(--border); border-radius: 16px; }
        .compact-table { width: 100%; min-width: 720px; border-collapse: collapse; background: #fff; }
        .compact-table th,
        .compact-table td { padding: 13px 15px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--border); }
        .compact-table th { color: var(--primary-dark); font-size: .84rem; background: var(--primary-soft); }
        .compact-table tr:last-child td { border-bottom: 0; }
        .compact-table td { color: var(--text-soft); }

        .example {
            margin-top: 20px;
            padding: 20px;
            border: 1px solid #d6e1f2;
            border-radius: var(--radius-md);
            background: linear-gradient(145deg,#f5f8fe,#fff);
        }
        .example-header {
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .example-title { margin: 0; color: var(--secondary); font-size: 1rem; }
        .tag {
            padding: 5px 9px;
            color: var(--secondary);
            font-size: .74rem;
            font-weight: 850;
            border-radius: 999px;
            background: var(--secondary-soft);
        }
        .solution-toggle {
            margin-top: 12px;
            padding: 9px 13px;
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--primary-dark);
            font-size: .86rem;
            font-weight: 850;
            cursor: pointer;
            border: 1px solid var(--border-strong);
            border-radius: 11px;
            background: var(--primary-soft);
        }
        .example-solution {
            display: none;
            margin-top: 14px;
            padding: 16px;
            border-left: 4px solid var(--primary);
            border-radius: 0 13px 13px 0;
            background: #fff;
        }
        .example-solution.open { display: block; animation: appear .25s ease; }
        @keyframes appear { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }

        .decision-flow {
            display: grid;
            grid-template-columns: repeat(4,minmax(0,1fr));
            gap: 12px;
            margin-top: 18px;
        }
        .decision-card {
            padding: 16px;
            text-align: center;
            border: 1px solid var(--border);
            border-radius: 16px;
            background: #fff;
        }
        .decision-card strong { display: block; color: var(--primary-dark); margin-bottom: 6px; }
        .decision-card span { color: var(--text-soft); font-size: .86rem; }

        .quiz-intro {
            padding: 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: linear-gradient(145deg,var(--primary-soft),#f8fcfb);
        }
        .quiz-intro h3 { margin: 0; color: var(--primary-dark); }
        .quiz-intro p { margin: 5px 0 0; color: var(--text-soft); }
        .quiz-summary-mini {
            min-width: 122px;
            padding: 12px 14px;
            color: var(--primary-dark);
            font-weight: 900;
            text-align: center;
            border: 1px solid var(--border-strong);
            border-radius: 14px;
            background: #fff;
        }
        .quiz-toolbar {
            margin-top: 16px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .quiz-filter { display: flex; flex-wrap: wrap; gap: 8px; }
        .filter-button {
            padding: 8px 12px;
            color: var(--text-soft);
            font-size: .83rem;
            font-weight: 750;
            cursor: pointer;
            border: 1px solid var(--border);
            border-radius: 999px;
            background: #fff;
        }
        .filter-button:hover,
        .filter-button.active { color: var(--primary-dark); border-color: var(--border-strong); background: var(--primary-soft); }
        .questions-container { margin-top: 18px; display: grid; gap: 16px; }
        .question-card {
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: #fff;
            transition: .2s ease;
        }
        .question-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
        .question-card.correct { border-color: #86c9ad; background: linear-gradient(145deg,#fff,var(--success-soft)); }
        .question-card.incorrect { border-color: #e5a4ad; background: linear-gradient(145deg,#fff,var(--danger-soft)); }
        .question-topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
        .question-number { margin: 0; color: var(--primary-dark); font-size: .82rem; font-weight: 900; letter-spacing: .04em; text-transform: uppercase; }
        .question-topic { padding: 5px 9px; color: var(--secondary); font-size: .72rem; font-weight: 850; border-radius: 999px; background: var(--secondary-soft); }
        .question-text { margin: 12px 0 15px; font-weight: 650; }
        .options { display: grid; gap: 9px; }
        .option {
            padding: 12px 13px;
            display: grid;
            grid-template-columns: auto minmax(0,1fr);
            align-items: start;
            gap: 10px;
            cursor: pointer;
            border: 1px solid var(--border);
            border-radius: 13px;
            background: var(--surface-soft);
            transition: .2s ease;
        }

            {id:13,topic:"Từng phần",type:"choice",question:"$\\displaystyle \\int\\ln xdx$ bằng:",options:["$\\dfrac1x+C$","$x\\ln x-x+C$","$x\\ln x+C$","$(\\ln x)^2+C$"],answer:1,solution:"Chọn $u=\\ln x$, $dv=dx$, được $x\\ln x-x+C$."},
            {id:14,topic:"Từng phần",type:"truefalse",question:"Khẳng định $\\displaystyle \\int x\\sin xdx=-x\\cos x+\\sin x+C$ là đúng hay sai?",options:["Đúng","Sai"],answer:0,solution:"Từng phần với $u=x$, $dv=\\sin xdx$ cho đúng kết quả trên."},
            {id:15,topic:"Biến đổi",type:"number",question:"Giá trị $\\displaystyle \\int_0^1(x+1)dx$ bằng bao nhiêu?",answer:1.5,tolerance:0.0001,placeholder:"Ví dụ: 1.5",solution:"$[x^2/2+x]_0^1=1/2+1=3/2=1.5$."}
        ];

        const STORAGE_KEY = "bai-hoc-phep-tinh-tich-phan-nguyen-duc-anh";
        let currentQuestions = [...quizQuestions];
        let currentFilter = "all";
        let submitted = false;

        const questionsContainer = document.getElementById("questionsContainer");
        const quizStatus = document.getElementById("quizStatus");
        const submitButton = document.getElementById("submitButton");
        const resetButton = document.getElementById("resetButton");
        const shuffleButton = document.getElementById("shuffleButton");
        const resultPanel = document.getElementById("resultPanel");
        const scoreRing = document.getElementById("scoreRing");
        const scoreText = document.getElementById("scoreText");
        const resultTitle = document.getElementById("resultTitle");
        const resultMessage = document.getElementById("resultMessage");
        const correctCount = document.getElementById("correctCount");
        const incorrectCount = document.getElementById("incorrectCount");
        const scorePercent = document.getElementById("scorePercent");

        function escapeHtml(value) {
            return String(value).replaceAll("&","&amp;").replaceAll("<","&lt;").replaceAll(">","&gt;").replaceAll('"',"&quot;").replaceAll("'","&#039;");
        }
        function shuffleArray(array) {
            const copied=[...array];
            for(let i=copied.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[copied[i],copied[j]]=[copied[j],copied[i]];}
            return copied;
        }
        function typesetMath() {
            if(window.MathJax && typeof window.MathJax.typesetPromise==="function"){
                window.MathJax.typesetPromise().catch(error=>console.warn("MathJax không thể hiển thị một số công thức.",error));
            }
        }
        function getSavedData() {
            try {
                const raw=localStorage.getItem(STORAGE_KEY);
                if(!raw) return {answers:{},settings:{}};
                const parsed=JSON.parse(raw);
                return {answers:parsed.answers||{},settings:parsed.settings||{}};
            } catch(error) { return {answers:{},settings:{}}; }
        }
        function saveData(data) { try { localStorage.setItem(STORAGE_KEY,JSON.stringify(data)); } catch(error) {} }
        function collectAnswers() {
            const answers={};
            quizQuestions.forEach(q=>{
                if(q.type==="choice"||q.type==="truefalse"){
                    const selected=document.querySelector(`input[name="question-${q.id}"]:checked`);
                    if(selected) answers[q.id]=Number(selected.value);
                }
                if(q.type==="number"){
                    const input=document.getElementById(`answer-${q.id}`);
                    if(input && input.value.trim()!=="") answers[q.id]=input.value.trim();
                }
            });
            return answers;
        }
        function saveAnswers(){const data=getSavedData();data.answers=collectAnswers();saveData(data);}
        function updateQuizStatus(){quizStatus.textContent=`${Object.keys(collectAnswers()).length}/${quizQuestions.length} câu`;}

        function renderQuestions(){
            const savedAnswers=getSavedData().answers||{};
            const visible=currentFilter==="all"?currentQuestions:currentQuestions.filter(q=>q.topic===currentFilter);
            questionsContainer.innerHTML=visible.map(q=>{
                const pos=currentQuestions.findIndex(item=>item.id===q.id)+1;
                let answerHtml="";
                if(q.type==="choice"||q.type==="truefalse"){
                    answerHtml=`<div class="options">${q.options.map((option,index)=>`<label class="option"><input type="radio" name="question-${q.id}" value="${index}" ${Number(savedAnswers[q.id])===index?"checked":""}><span>${option}</span></label>`).join("")}</div>`;
                } else {
                    const saved=savedAnswers[q.id]??"";
                    answerHtml=`<div class="short-answer-wrap"><input class="short-answer-input" id="answer-${q.id}" type="text" inputmode="decimal" autocomplete="off" value="${escapeHtml(saved)}" placeholder="${escapeHtml(q.placeholder||"Nhập đáp án")}" aria-label="Đáp án câu ${pos}"><span class="answer-note">Có thể dùng dấu chấm hoặc dấu phẩy làm dấu thập phân.</span></div>`;
                }
                return `<article class="question-card" id="question-card-${q.id}"><div class="question-topline"><p class="question-number">Câu ${pos}</p><span class="question-topic">${escapeHtml(q.topic)}</span></div><div class="question-text">${q.question}</div>${answerHtml}<div class="question-feedback" id="feedback-${q.id}"></div></article>`;
            }).join("");
            bindQuestionEvents();
            updateQuizStatus();
            if(submitted) gradeQuiz(false);
            typesetMath();
        }
        function bindQuestionEvents(){
            questionsContainer.querySelectorAll("input").forEach(input=>{
                ["change","input"].forEach(eventName=>input.addEventListener(eventName,()=>{
                    submitted=false;
                    resultPanel.classList.remove("show");
                    document.querySelectorAll(".question-card").forEach(card=>card.classList.remove("correct","incorrect"));
                    document.querySelectorAll(".question-feedback").forEach(f=>f.classList.remove("show"));
                    saveAnswers();updateQuizStatus();
                }));
            });
        }
        function isQuestionCorrect(q,answer){
            if(q.type==="choice"||q.type==="truefalse") return Number(answer)===q.answer;
            if(q.type==="number"){
                if(answer===undefined||answer===null||String(answer).trim()==="") return false;
                const value=Number.parseFloat(String(answer).trim().replace(",","."));
                return Number.isFinite(value)&&Math.abs(value-q.answer)<=(q.tolerance??0.0001);
            }
            return false;
        }
        function getCorrectAnswerDisplay(q){return (q.type==="choice"||q.type==="truefalse")?q.options[q.answer]:String(q.answer);}
        function gradeQuiz(showResult=true){
            const answers=collectAnswers();let correct=0;
            quizQuestions.forEach(q=>{
                const ok=isQuestionCorrect(q,answers[q.id]);if(ok) correct++;
                const card=document.getElementById(`question-card-${q.id}`);const feedback=document.getElementById(`feedback-${q.id}`);
                if(!card||!feedback) return;
                card.classList.remove("correct","incorrect");card.classList.add(ok?"correct":"incorrect");
                feedback.innerHTML=`<strong>${ok?"Chính xác.":"Chưa chính xác."}</strong>${ok?"":`<div>Đáp án đúng: ${getCorrectAnswerDisplay(q)}</div>`}<div style="margin-top:6px;">${q.solution}</div>`;
                feedback.classList.add("show");
            });
            submitted=true;saveAnswers();
            if(!showResult){typesetMath();return;}
            const total=quizQuestions.length,incorrect=total-correct,percent=Math.round(correct/total*100);
            scoreRing.style.setProperty("--score-angle",`${percent/100*360}deg`);scoreText.textContent=`${correct}/${total}`;correctCount.textContent=correct;incorrectCount.textContent=incorrect;scorePercent.textContent=`${percent}%`;
            if(percent>=90){resultTitle.textContent="Xuất sắc!";resultMessage.textContent="Bạn nhận dạng phương pháp và tính toán rất tốt.";}
            else if(percent>=75){resultTitle.textContent="Kết quả tốt!";resultMessage.textContent="Bạn đã nắm phần lớn các dạng tích phân cơ bản.";}
            else if(percent>=50){resultTitle.textContent="Đạt mức cơ bản";resultMessage.textContent="Hãy xem lại cách chọn đổi biến và cách đặt u, dv trong từng phần.";}
            else{resultTitle.textContent="Cần luyện thêm";resultMessage.textContent="Nên làm lại các ví dụ mẫu theo đúng quy trình từng bước.";}
            resultPanel.classList.add("show");resultPanel.scrollIntoView({behavior:"smooth",block:"center"});typesetMath();
        }
        function resetQuiz(){
            if(!window.confirm("Bạn có chắc muốn xóa toàn bộ đáp án và làm lại bài?")) return;
            const data=getSavedData();data.answers={};saveData(data);submitted=false;resultPanel.classList.remove("show");currentQuestions=[...quizQuestions];currentFilter="all";
            document.querySelectorAll(".filter-button").forEach(btn=>btn.classList.toggle("active",btn.dataset.filter==="all"));renderQuestions();document.getElementById("luyen-tap").scrollIntoView({behavior:"smooth",block:"start"});
        }
        function shuffleQuestions(){currentQuestions=shuffleArray(currentQuestions);submitted=false;resultPanel.classList.remove("show");renderQuestions();}

        document.querySelectorAll(".filter-button").forEach(button=>button.addEventListener("click",()=>{
            currentFilter=button.dataset.filter;document.querySelectorAll(".filter-button").forEach(item=>item.classList.remove("active"));button.classList.add("active");renderQuestions();
        }));
        document.querySelectorAll(".solution-toggle").forEach(button=>button.addEventListener("click",()=>{
            const target=document.getElementById(button.dataset.target);const isOpen=target.classList.toggle("open");button.textContent=isOpen?"Ẩn lời giải":"Xem lời giải";button.setAttribute("aria-expanded",String(isOpen));if(isOpen) typesetMath();
        }));

        const observedSections=document.querySelectorAll("main section[id]");
        const tocLinks=document.querySelectorAll(".toc-link");
        const observer=new IntersectionObserver(entries=>{
            const visible=entries.filter(e=>e.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio);
            if(!visible.length) return;
            const id=visible[0].target.id;
            tocLinks.forEach(link=>{const active=link.getAttribute("href")===`#${id}`;link.classList.toggle("active",active);if(active) link.scrollIntoView({behavior:"smooth",inline:"center",block:"nearest"});});
        },{rootMargin:"-20% 0px -63% 0px",threshold:[.05,.2,.45]});
        observedSections.forEach(section=>observer.observe(section));

        const progressFill=document.getElementById("progressFill");
        const backToTop=document.getElementById("backToTop");
        function updateReadingProgress(){
            const top=window.scrollY||document.documentElement.scrollTop;
            const height=document.documentElement.scrollHeight-window.innerHeight;
            const progress=height>0?Math.min(100,Math.max(0,Math.round(top/height*100))):0;
            progressFill.style.width=`${progress}%`;backToTop.classList.toggle("show",top>550);
        }
        window.addEventListener("scroll",updateReadingProgress,{passive:true});
        backToTop.addEventListener("click",()=>window.scrollTo({top:0,behavior:"smooth"}));

        const fontSizeButton=document.getElementById("fontSizeButton");
        const contrastButton=document.getElementById("contrastButton");
        function loadSettings(){const settings=getSavedData().settings||{};if(settings.largeText)document.body.classList.add("large-text");if(settings.highContrast)document.body.classList.add("high-contrast");}
        function saveSettings(){const data=getSavedData();data.settings={largeText:document.body.classList.contains("large-text"),highContrast:document.body.classList.contains("high-contrast")};saveData(data);}
        fontSizeButton.addEventListener("click",()=>{document.body.classList.toggle("large-text");saveSettings();});
        contrastButton.addEventListener("click",()=>{document.body.classList.toggle("high-contrast");saveSettings();});
        submitButton.addEventListener("click",()=>gradeQuiz(true));
        resetButton.addEventListener("click",resetQuiz);
        shuffleButton.addEventListener("click",shuffleQuestions);

        function initializePage(){loadSettings();renderQuestions();updateReadingProgress();updateQuizStatus();window.addEventListener("load",typesetMath);}
        initializePage();
    </script>
</body>
</html>
